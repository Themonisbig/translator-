# Runtime only. Reuse RunPod secret bindings; never commit values.
# Public Drama 3 weights do not require authentication. Optional for HF rate limits.
HF_TOKEN=
WEB_USERNAME=persona
WEB_PASSWORD=
HF_HOME=/workspace/huggingface
MODEL_DIR=/workspace/checkpoints/drama-3
RUN_GPU_SMOKE=1

# Required memory profile for this single 48GB GPU deployment.
FISH_DRAMA3_CUDA_GRAPH=1
FISH_CODEC_DEVICE=cpu
FISH_CPU_THREADS=8
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
